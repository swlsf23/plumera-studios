{
  "name": "plumera-studios",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:site && npm run preview:site",
    "build": "npm run build:site",
    "build:site": "python -m tools.content_builder",
    "preview:site": "npx --yes serve dist -l 4173",
    "dev:app": "vite",
    "build:app": "tsc --noEmit && vite build",
    "preview:app": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
